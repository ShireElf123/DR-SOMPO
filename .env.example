# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.drngweysompo.co.za

# Appointment enquiry delivery.
#
# The site never stores enquiries. When ENQUIRY_WEBHOOK_URL is set, the
# /api/enquiry route forwards a minimal, non-clinical enquiry payload to it
# (for example a transactional email provider, a form endpoint, or the
# practice's booking inbox relay).
#
# If it is NOT set, the form fails closed and asks the patient to call or email
# the practice — it never pretends an enquiry was delivered.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
