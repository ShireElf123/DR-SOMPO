# Public canonical origin. Replace this local placeholder with the approved
# live domain; Vercel production requires an explicit NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=https://www.drngweysompo.co.za

# Online enquiry collection stays OFF until delivery, privacy/retention,
# distributed abuse controls and an authorised receipt check are approved.
# See docs/enquiry-operations.md. A URL alone does not enable the form.
ENQUIRY_ENABLED=false

# Server-only approved HTTPS receiver and optional Bearer token.
# Never put credentials in NEXT_PUBLIC_ variables or commit live secrets.
# The app does not log enquiry bodies; provider/hosting retention still needs
# an agreed policy. Do not describe the entire delivery chain as storing nothing.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
